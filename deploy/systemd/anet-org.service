# anet-org.service - the organisation program anet-org (systemd user unit).
#
# Install into ~/.config/systemd/user/ of the dedicated account, with
#   ~/.local/bin/anet-org                  the binary
#   ~/.config/anet-org/anet-org.json       the configuration (deploy/anet-org.example.json)
#   ~/.config/anet-org/token               the bearer token shared with the node (anet-org gen-token)
# then: systemctl --user daemon-reload && systemctl --user enable --now anet-org anet-org-node
# and, so the units run without a login session: loginctl enable-linger <account>.
#
# The program listens on a Unix socket in its runtime directory,
# ${XDG_RUNTIME_DIR}/anet-org/backend.sock (mode 0600); the node's service
# module checks the directory chain and the listener's uid before it sends
# anything. The program opens no network port and makes no outbound
# connection, so it is limited to Unix sockets.
[Unit]
Description=anet-org organisation program
Documentation=https://github.com/ANetResearch/anet-org
Before=anet-org-node.service

[Service]
Type=simple
Slice=anet-org.slice
ExecStart=%h/.local/bin/anet-org serve --config %E/anet-org/anet-org.json
RuntimeDirectory=anet-org
RuntimeDirectoryMode=0700
# "+": created outside the sandbox below, before ReadWritePaths= needs it.
ExecStartPre=+/bin/mkdir -p -m 0700 %h/.local/state/anet-org
Restart=on-failure
RestartSec=3s
UMask=0077
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
# Seccomp filters work in any user manager.
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
# The namespace settings below need a user namespace in a user unit
# (systemd.exec(5), "Sandboxing": they "will work when used in conjunction
# with PrivateUsers=true"); where the kernel or a security module refuses
# unprivileged user namespaces, systemd leaves them without effect and the
# service still starts. Inside, root and other accounts appear as nobody:
# anet-org checks no file owners, so this is harmless here (the node unit
# cannot use it; see there).
PrivateUsers=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHostname=yes
ReadWritePaths=-%h/.local/state/anet-org %t/anet-org
CPUQuota=300%
MemoryMax=3G
TasksMax=256
LimitNOFILE=4096

[Install]
WantedBy=default.target
